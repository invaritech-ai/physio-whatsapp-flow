# Environment
APP_ENV=development
APP_BASE_URL=https://movement-wa-api.weekendsuite.com
WEB_BASE_URL=https://app.your-domain.example

# Database (Neon recommended)
# DATABASE_URL=postgresql+psycopg://user:password@host/dbname?sslmode=require
DATABASE_URL=sqlite:///./physio.db

# Neon Auth (required for user auth)
NEON_AUTH_URL=https://ep-your-branch.neonauth.your-region.aws.neon.tech/neondb/auth
NEON_JWKS_URL=https://ep-your-branch.neonauth.your-region.aws.neon.tech/neondb/auth/jwks
NEON_JWT_ISSUER=https://ep-your-branch.neonauth.your-region.aws.neon.tech/neondb/auth
NEON_JWT_AUDIENCE=neon-auth
# Optional hardening: enforce short-lived access tokens in backend
AUTH_ENFORCE_ACCESS_TTL=false
AUTH_MAX_ACCESS_TOKEN_TTL_SECONDS=600

# Twilio (WhatsApp bot)
TWILIO_ACCOUNT_SID=your_sid_here
TWILIO_AUTH_TOKEN=your_token_here
TWILIO_WHATSAPP_NUMBER=whatsapp:+14155238886
TWILIO_WEBHOOK_SECRET=your_twilio_signature_secret

# Calendly (organization-level token - optional fallback)
CALENDLY_API_TOKEN=your_org_calendly_token
# Supports comma-separated values when multiple Calendly org signing keys are used.
CALENDLY_WEBHOOK_SECRET=your_calendly_webhook_secret

# Encryption (REQUIRED for storing therapist Calendly PATs)
# Generate with: python scripts/generate_encryption_key.py
# Keep this secret! Never commit to git.
ENCRYPTION_KEY=your_fernet_encryption_key_here

# Public URLs
# Must match the externally reachable API host that Twilio calls.
# Used for Twilio signature verification URL reconstruction.
PUBLIC_BASE_URL=https://movement-wa-api.weekendsuite.com

# Currency
DEFAULT_CURRENCY=HKD

# Storage (proofs / receipts) - optional for future use
STORAGE_ENDPOINT=https://s3.your-domain.example
STORAGE_BUCKET=your-bucket
STORAGE_ACCESS_KEY=your-access-key
STORAGE_SECRET_KEY=your-secret-key

# Debug Mode (Optional)
DEBUG_MODE=false

# Celery + Redis (async task queue)
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/0
