# Environment
APP_ENV=development
APP_BASE_URL=https://movement-wa-api.weekendsuite.com
WEB_BASE_URL=https://app.your-domain.example

# Database (Neon recommended)
# DATABASE_URL=postgresql+psycopg://user:password@host/dbname?sslmode=require
DATABASE_URL=sqlite:///./physio.db

# Neon Auth (required for user auth)
NEON_AUTH_URL=https://ep-your-branch.neonauth.your-region.aws.neon.tech/neondb/auth
NEON_JWKS_URL=https://ep-your-branch.neonauth.your-region.aws.neon.tech/neondb/auth/jwks
NEON_JWT_ISSUER=https://ep-your-branch.neonauth.your-region.aws.neon.tech/neondb/auth
NEON_JWT_AUDIENCE=neon-auth
# Optional hardening: enforce short-lived access tokens in backend
AUTH_ENFORCE_ACCESS_TTL=false
AUTH_MAX_ACCESS_TOKEN_TTL_SECONDS=600

# Twilio (WhatsApp bot)
TWILIO_ACCOUNT_SID=your_sid_here
TWILIO_AUTH_TOKEN=your_token_here
TWILIO_WHATSAPP_NUMBER=whatsapp:+14155238886
TWILIO_WEBHOOK_SECRET=your_twilio_signature_secret

# Calendly (organization-level token - optional fallback)
CALENDLY_API_TOKEN=your_org_calendly_token
# Deprecated for runtime verification: webhook signing keys are now stored per therapist in DB.
# Keep only for legacy/manual testing if needed.
CALENDLY_WEBHOOK_SECRET=

# Encryption (REQUIRED for storing therapist Calendly PATs)
# Generate with: python scripts/generate_encryption_key.py
# Keep this secret! Never commit to git.
ENCRYPTION_KEY=your_fernet_encryption_key_here

# Public URLs
# Must match the externally reachable API host that Twilio calls.
# Used for Twilio signature verification URL reconstruction.
PUBLIC_BASE_URL=https://movement-wa-api.weekendsuite.com

# Currency
DEFAULT_CURRENCY=HKD

# Invoice rendering + storage
INVOICE_RENDERER=basic
INVOICE_LATEX_TEMPLATE_PATH=templates/invoices/receipt.tex
INVOICE_LATEX_ENGINE=tectonic
INVOICE_LATEX_TIMEOUT_SECONDS=30
INVOICE_LATEX_FALLBACK_TO_BASIC=true

# Invoice document serving (local dev default)
INVOICE_STORAGE_DIR=/tmp/physio_invoice_pdfs
INVOICE_PUBLIC_PATH=/generated/invoices
INVOICE_PUBLIC_BASE_URL=
INVOICE_STORAGE_BACKEND=local

# S3-compatible invoice storage (AWS S3 / OCI Object Storage)
# For OCI, use the compat endpoint format:
# https://<namespace>.compat.objectstorage.<region>.oraclecloud.com
INVOICE_S3_ENDPOINT_URL=
INVOICE_S3_BUCKET=
INVOICE_S3_REGION=
INVOICE_S3_PREFIX=invoices
INVOICE_S3_ACCESS_KEY_ID=
INVOICE_S3_SECRET_ACCESS_KEY=
INVOICE_S3_PUBLIC_BASE_URL=
INVOICE_S3_PRESIGN_TTL_SECONDS=900

# Invoice/business formatting
INVOICE_TIMEZONE=Asia/Hong_Kong
BUSINESS_NAME=Movement Group Limited
BUSINESS_ADDRESS=19A-19B High Street, G/F High House, Hong Kong, Sai Ying Pun, NA
BUSINESS_PHONE=63121852
BUSINESS_EMAIL=hello@movementfitnesshk.com

# Debug Mode (Optional)
DEBUG_MODE=false

# Celery + Redis (async task queue)
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/0
CELERY_WEBHOOK_ASYNC_ENABLED=false
CELERY_INVOICE_PDF_TASK_ENABLED=false
CELERY_INVOICE_TASK_TIMEOUT_SECONDS=60
# Optional: minute-level override for faster test loops (takes precedence over HOURS)
# Example for testing every 2 minutes:
# CELERY_SYNC_INTERVAL_MINUTES=2
CELERY_SYNC_INTERVAL_HOURS=4
CELERY_BOOKING_FOLLOWUP_ENABLED=false
BOOKING_FOLLOWUP_FIRST_DELAY_SECONDS=3600
BOOKING_FOLLOWUP_SECOND_DELAY_SECONDS=21600
