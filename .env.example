# ============================================================
# Physio WhatsApp Flow - Backend Environment Template
# ============================================================
# Copy to `.env` and fill all REQUIRED values.

# ------------------------------------------------------------
# Core Runtime
# ------------------------------------------------------------
# Use `production` in deployed env. In production WEB_BASE_URL is required.
APP_ENV=development
WEB_BASE_URL=https://app.your-domain.example

# Docker host port mapping for the API service.
# Change this when multiple apps share the same server.
API_HOST_PORT=8000

# Externally reachable API base URL used for webhook URL reconstruction.
PUBLIC_BASE_URL=https://movement-wa-api.weekendsuite.com

# Legacy/deploy-platform only (not read by backend config):
# APP_BASE_URL=https://movement-wa-api.weekendsuite.com

# ------------------------------------------------------------
# Database (REQUIRED)
# ------------------------------------------------------------
# Local:
DATABASE_URL=sqlite:///./physio.db
# Production (example):
# DATABASE_URL=postgresql+psycopg://user:password@host/dbname?sslmode=require&channel_binding=require

# ------------------------------------------------------------
# Neon Auth (REQUIRED if auth enabled)
# ------------------------------------------------------------
NEON_AUTH_URL=https://ep-your-branch.neonauth.your-region.aws.neon.tech/neondb/auth
NEON_JWKS_URL=https://ep-your-branch.neonauth.your-region.aws.neon.tech/neondb/auth/.well-known/jwks.json
# Set these to the exact `iss` and `aud` claims from issued tokens.
NEON_JWT_ISSUER=https://ep-your-branch.neonauth.your-region.aws.neon.tech
NEON_JWT_AUDIENCE=neon-auth

# Optional hardening
AUTH_ENFORCE_ACCESS_TTL=false
AUTH_MAX_ACCESS_TOKEN_TTL_SECONDS=600

# ------------------------------------------------------------
# Twilio WhatsApp (REQUIRED for WhatsApp webhook flow)
# ------------------------------------------------------------
TWILIO_ACCOUNT_SID=your_sid_here
TWILIO_AUTH_TOKEN=your_token_here
TWILIO_WHATSAPP_NUMBER=whatsapp:+14155238886

# Currently not enforced in runtime verifier (kept for compatibility):
TWILIO_WEBHOOK_SECRET=your_twilio_signature_secret

# ------------------------------------------------------------
# Calendly
# ------------------------------------------------------------
# Optional org-level token fallback (primary runtime uses therapist PATs).
CALENDLY_API_TOKEN=your_org_calendly_token

# Deprecated/legacy key (signing keys are stored per therapist in DB):
CALENDLY_WEBHOOK_SECRET=

# ------------------------------------------------------------
# Encryption (REQUIRED for storing therapist PATs)
# ------------------------------------------------------------
# Generate with: python scripts/generate_encryption_key.py
ENCRYPTION_KEY=your_fernet_encryption_key_here

# ------------------------------------------------------------
# Currency + Business Invoice Fields
# ------------------------------------------------------------
DEFAULT_CURRENCY=HKD
INVOICE_TIMEZONE=Asia/Hong_Kong
BUSINESS_NAME=Movement Group Limited
BUSINESS_ADDRESS=19A-19B High Street, G/F High House, Hong Kong, Sai Ying Pun, NA
BUSINESS_PHONE=63121852
BUSINESS_EMAIL=hello@movementfitnesshk.com

# ------------------------------------------------------------
# Invoice Rendering
# ------------------------------------------------------------
# `basic` (HTML/pdfkit-style) or `latex`.
INVOICE_RENDERER=basic
INVOICE_LATEX_TEMPLATE_PATH=templates/invoices/receipt.tex
INVOICE_LATEX_ENGINE=tectonic
INVOICE_LATEX_TIMEOUT_SECONDS=30
INVOICE_LATEX_FALLBACK_TO_BASIC=true

# ------------------------------------------------------------
# Invoice Storage
# ------------------------------------------------------------
# local | s3 | auto
INVOICE_STORAGE_BACKEND=local
INVOICE_STORAGE_DIR=/tmp/physio_invoice_pdfs
INVOICE_PUBLIC_PATH=/generated/invoices
INVOICE_PUBLIC_BASE_URL=

# S3-compatible storage (AWS S3 / OCI Object Storage compat endpoint)
# For OCI: https://<namespace>.compat.objectstorage.<region>.oraclecloud.com
INVOICE_S3_ENDPOINT_URL=
INVOICE_S3_BUCKET=
INVOICE_S3_REGION=
INVOICE_S3_PREFIX=invoices
INVOICE_S3_ACCESS_KEY_ID=
INVOICE_S3_SECRET_ACCESS_KEY=
INVOICE_S3_PUBLIC_BASE_URL=
INVOICE_S3_PRESIGN_TTL_SECONDS=900

# Legacy names not read by backend (use INVOICE_S3_* instead):
# STORAGE_ENDPOINT=
# STORAGE_BUCKET=
# STORAGE_ACCESS_KEY=
# STORAGE_SECRET_KEY=

# ------------------------------------------------------------
# Debug
# ------------------------------------------------------------
# When true: structured INFO logs prefixed with [PROCESS-TRACE] for Calendly webhook,
# WhatsApp webhook, and bot process_message (JSON: trace_id, channel, stage, ...).
# Calendly success responses include trace_id for correlation with Calendly delivery logs.
DEBUG_MODE=false

# ------------------------------------------------------------
# Periodic Sync + Booking Follow-ups
# ------------------------------------------------------------
# Optional minute override for event-type sync (takes precedence over HOURS):
# SYNC_INTERVAL_MINUTES=2
SYNC_INTERVAL_HOURS=4

# Availability sync cadence/cache
AVAILABILITY_SYNC_INTERVAL_MINUTES=30
AVAILABILITY_CACHE_TTL_MINUTES=45

# Booking-link follow-up nudges (1h/6h) via in-process scheduler
BOOKING_FOLLOWUP_ENABLED=false
BOOKING_FOLLOWUP_FIRST_DELAY_SECONDS=3600
BOOKING_FOLLOWUP_SECOND_DELAY_SECONDS=21600

# Deploy-platform vars (not read by backend config directly):
# NIXPACKS_NODE_VERSION=22
# SERVICE_URL_API=https://movement-wa-api.weekendsuite.com
# SERVICE_FQDN_API=movement-wa-api.weekendsuite.com
