# Environment
APP_ENV=development
APP_BASE_URL=https://api.your-domain.example
WEB_BASE_URL=https://app.your-domain.example

# Database (Neon recommended)
# DATABASE_URL=postgresql+psycopg://user:password@host/dbname?sslmode=require
DATABASE_URL=sqlite:///./physio.db

# Twilio (WhatsApp bot)
TWILIO_ACCOUNT_SID=your_sid_here
TWILIO_AUTH_TOKEN=your_token_here
TWILIO_WHATSAPP_NUMBER=whatsapp:+14155238886
TWILIO_WEBHOOK_SECRET=your_twilio_signature_secret

# Calendly
CALENDLY_API_TOKEN=your_calendly_token
CALENDLY_WEBHOOK_SECRET=your_calendly_webhook_secret

# Storage (proofs / receipts)
STORAGE_ENDPOINT=https://s3.your-domain.example
STORAGE_BUCKET=your-bucket
STORAGE_ACCESS_KEY=your-access-key
STORAGE_SECRET_KEY=your-secret-key

# Debug Mode (Optional)
DEBUG_MODE=false
